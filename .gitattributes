# Normalize line endings to LF in the repo; git will handle CRLF on checkout
# based on core.autocrlf / core.eol settings per platform.
* text=auto

# Force LF for all text source files regardless of platform setting
*.scad   text eol=lf
*.py     text eol=lf
*.pl     text eol=lf
*.mjs    text eol=lf
*.ts     text eol=lf
*.astro  text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.svg    text eol=lf
*.lua    text eol=lf
*.ps1    text eol=lf
*.mmd    text eol=lf

# Binary — never touch line endings
*.stl    binary
*.STL    binary
*.3mf    binary
*.png    binary
*.jpg    binary
*.bmp    binary
*.gif    binary
*.zip    binary
*.7z     binary
*.tar.gz binary
*.pyc    binary
